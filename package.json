{
  "name": "edusoft-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "prisma": "^6.2.1"
  },
  "scripts": {
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma && cd frontend && npm install && npm run build && cd .. && cp -rv frontend/dist/* .",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend"
  }
}
